# Quotation form (api/quote.js) settings.
# Set these in Vercel: Project > Settings > Environment Variables. Never commit real values.

# Required. API key from https://resend.com/api-keys (starts with "re_").
RESEND_API_KEY=

# Optional. Where quotation requests are delivered. Defaults to the studio address shown on the site.
QUOTE_TO_EMAIL=inko.melbourne@gmail.com

# Optional. Sender shown on the email. Defaults to Resend's shared test sender, which can ONLY deliver to the
# email address that owns the Resend account. To use your own sender, verify a domain in Resend first.
QUOTE_FROM_EMAIL=INKO Melbourne Website <onboarding@resend.dev>
