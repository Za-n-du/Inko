      "elements": [
        {
          "id": "ihhome02",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"inko-home\" id=\"home\">\n  <section class=\"ih-hero\" aria-labelledby=\"ih-hero-title\">\n    <img class=\"ih-hero__photo\" src=\"/wp-content/themes/inko-melbourne/assets/images/inko-hero-background.jpg\" alt=\"Japanese-style dragon tattoo across a client's back\" fetchpriority=\"high\" decoding=\"async\">\n    <div class=\"ih-hero__shade\"></div>\n    <div class=\"ih-hero__copy\">\n      <p class=\"ih-kicker\">Premium tattoos</p>\n      <h1 id=\"ih-hero-title\">INKO <span>MELBOURNE</span></h1>\n      <p class=\"ih-hero__description\">Custom tattoos by world-class artists in Melbourne.</p>\n      <a class=\"ih-button\" href=\"#promotions\">See promos <span aria-hidden=\"true\">→</span></a>\n    </div>\n  </section>\n\n  <section class=\"ih-section ih-intro\" id=\"studio-intro\" aria-labelledby=\"ih-intro-title\">\n    <div class=\"ih-section__head ih-intro__head\"><p class=\"ih-eyebrow\">INKO Melbourne</p><h2 id=\"ih-intro-title\">Tattooing, <em>considered.</em></h2><p>Fine-line, realism and custom tattoos.</p></div>\n    <div class=\"ih-services\">\n      <a class=\"ih-service\" href=\"#work-fine-line\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/fl-01-lg.webp\" alt=\"Fine-line tattoo from INKO Melbourne\" loading=\"lazy\" decoding=\"async\"><span>01</span><h3>Fine-line</h3><b aria-hidden=\"true\">↗</b></a>\n      <a class=\"ih-service\" href=\"#work-realism\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/re-01-lg.webp\" alt=\"Realism tattoo from INKO Melbourne\" loading=\"lazy\" decoding=\"async\"><span>02</span><h3>Realism</h3><b aria-hidden=\"true\">↗</b></a>\n      <a class=\"ih-service\" href=\"#work\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/fl-02-lg.webp\" alt=\"Custom tattoo artwork from INKO Melbourne\" loading=\"lazy\" decoding=\"async\"><span>03</span><h3>Custom tattoos</h3><b aria-hidden=\"true\">↗</b></a>\n    </div>\n  </section>\n\n  <section class=\"ih-section ih-promos\" id=\"promotions\" aria-labelledby=\"ih-promos-title\">\n    <div class=\"ih-section__head\"><p class=\"ih-eyebrow\">Current offers</p><h2 id=\"ih-promos-title\">Studio <em>promotions</em></h2></div>\n    <div class=\"ih-promo-grid\">\n      <a href=\"/quote/\" class=\"ih-promo\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/promo-01-lg.webp\" alt=\"INKO Melbourne promotion\" loading=\"lazy\" decoding=\"async\"></a>\n      <a href=\"/quote/\" class=\"ih-promo\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/promo-02-lg.webp\" alt=\"INKO Melbourne promotion\" loading=\"lazy\" decoding=\"async\"></a>\n      <a href=\"/quote/\" class=\"ih-promo\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/promo-03-lg.webp\" alt=\"INKO Melbourne promotion\" loading=\"lazy\" decoding=\"async\"></a>\n      <a href=\"/quote/\" class=\"ih-promo\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/promo-04-lg.webp\" alt=\"INKO Melbourne promotion\" loading=\"lazy\" decoding=\"async\"></a>\n      <a href=\"/quote/\" class=\"ih-promo\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/promo-05-lg.webp\" alt=\"INKO Melbourne promotion\" loading=\"lazy\" decoding=\"async\"></a>\n      <a href=\"/quote/\" class=\"ih-promo\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/promo-06-lg.webp\" alt=\"INKO Melbourne promotion\" loading=\"lazy\" decoding=\"async\"></a>\n      <a href=\"/quote/\" class=\"ih-promo\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/promo-07-lg.webp\" alt=\"INKO Melbourne promotion\" loading=\"lazy\" decoding=\"async\"></a>\n    </div>\n    <a class=\"ih-text-link\" href=\"#quote\">Enquire about a promotion <span aria-hidden=\"true\">↗</span></a>\n  </section>\n\n  <section class=\"ih-section ih-work\" id=\"work\" aria-labelledby=\"ih-work-title\">\n    <div class=\"ih-section__head ih-work__head\"><p class=\"ih-eyebrow\">Selected work</p><h2 id=\"ih-work-title\">Made to be <em>yours.</em></h2><p>Explore Fine-line and Realism work by INKO Melbourne artists.</p></div>\n    <div class=\"ih-filter\" aria-label=\"Work categories\"><a href=\"#work-fine-line\">Fine-line</a><a href=\"#work-realism\">Realism</a><a href=\"#artists\">Meet the artists</a></div>\n    <div class=\"ih-gallery\" id=\"work-fine-line\" aria-label=\"Fine-line and realism tattoo gallery\">\n      <figure><img src=\"/wp-content/themes/inko-melbourne/assets/images/fl-01-lg.webp\" alt=\"Fine-line tattoo artwork, photo 1\" loading=\"lazy\" decoding=\"async\"><figcaption>Fine-line</figcaption></figure>\n      <figure id=\"work-realism\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/re-01-lg.webp\" alt=\"Realism tattoo artwork, photo 1\" loading=\"lazy\" decoding=\"async\"><figcaption>Realism</figcaption></figure>\n      <figure><img src=\"/wp-content/themes/inko-melbourne/assets/images/re-02-lg.webp\" alt=\"Realism tattoo artwork, photo 2\" loading=\"lazy\" decoding=\"async\"><figcaption>Realism</figcaption></figure>\n      <figure><img src=\"/wp-content/themes/inko-melbourne/assets/images/fl-02-lg.webp\" alt=\"Fine-line tattoo artwork, photo 2\" loading=\"lazy\" decoding=\"async\"><figcaption>Fine-line</figcaption></figure>\n      <figure><img src=\"/wp-content/themes/inko-melbourne/assets/images/re-03-lg.webp\" alt=\"Realism tattoo artwork, photo 3\" loading=\"lazy\" decoding=\"async\"><figcaption>Realism</figcaption></figure>\n      <figure><img src=\"/wp-content/themes/inko-melbourne/assets/images/re-04-lg.webp\" alt=\"Realism tattoo artwork, photo 4\" loading=\"lazy\" decoding=\"async\"><figcaption>Realism</figcaption></figure>\n      <figure><img src=\"/wp-content/themes/inko-melbourne/assets/images/re-05-lg.webp\" alt=\"Realism tattoo artwork, photo 5\" loading=\"lazy\" decoding=\"async\"><figcaption>Realism</figcaption></figure>\n      <figure><img src=\"/wp-content/themes/inko-melbourne/assets/images/re-06-lg.webp\" alt=\"Realism tattoo artwork, photo 6\" loading=\"lazy\" decoding=\"async\"><figcaption>Realism</figcaption></figure>\n    </div>\n    <a class=\"ih-button ih-button--outline\" href=\"https://www.instagram.com/inko_melbourne/\" target=\"_blank\" rel=\"noopener\">View more on Instagram <span aria-hidden=\"true\">↗</span></a>\n  </section>\n\n  <section class=\"ih-section ih-artists\" id=\"artists\" aria-labelledby=\"ih-artists-title\">\n    <div class=\"ih-section__head\"><p class=\"ih-eyebrow\">The people behind the work</p><h2 id=\"ih-artists-title\">Meet our <em>artists.</em></h2></div>\n    <div class=\"ih-artist-track\" data-carousel=\"artists\" aria-label=\"INKO Melbourne artists\">\n      <article class=\"ih-artist\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/art-01.webp\" alt=\"Elmundo, tattoo artist at INKO Melbourne\" loading=\"lazy\" decoding=\"async\"><div><h3>Elmundo</h3><p>AKA ELM J</p></div></article>\n      <article class=\"ih-artist\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/art-02.webp\" alt=\"Don, founder and tattoo artist at INKO Melbourne\" loading=\"lazy\" decoding=\"async\"><div><h3>Don</h3><p>AKA OIDONNY <span>Founder</span></p></div></article>\n      <article class=\"ih-artist\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/art-04.webp\" alt=\"Yinkspire, tattoo artist at INKO Melbourne\" loading=\"lazy\" decoding=\"async\"><div><h3>Yinkspire</h3><p>AKA Yosufi</p></div></article>\n      <article class=\"ih-artist\"><img src=\"/wp-content/themes/inko-melbourne/assets/images/art-03.webp\" alt=\"Swan, tattoo artist at INKO Melbourne\" loading=\"lazy\" decoding=\"async\"><div><h3>Swan</h3><p>AKA BunnyGirlInk</p></div></article>\n    </div>\n    <div class=\"ih-carousel-controls\"><button type=\"button\" data-carousel-prev=\"artists\" aria-label=\"Previous artists\">←</button><button type=\"button\" data-carousel-next=\"artists\" aria-label=\"Next artists\">→</button></div>\n  </section>\n\n  <section class=\"ih-location\" id=\"location\" aria-labelledby=\"ih-location-title\">\n    <div class=\"ih-location__copy\"><p class=\"ih-eyebrow\">Find us</p><h2 id=\"ih-location-title\">Our <em>studio.</em></h2><p class=\"ih-address\">1c Cookson Street<br>Camberwell, VIC 3142</p><p>Tucked into the creative pocket of Cookson Street, INKO Melbourne is a quick walk from Camberwell Station.</p><a class=\"ih-button\" href=\"https://www.google.com/maps/dir/?api=1&destination=INKO+Melbourne%2C+1C+Cookson+Street%2C+Camberwell+VIC+3142\" target=\"_blank\" rel=\"noopener\">Get directions <span aria-hidden=\"true\">↗</span></a></div>\n    <div class=\"ih-location__gallery\" aria-label=\"INKO Melbourne studio photos\">\n      <img src=\"/wp-content/themes/inko-melbourne/assets/images/loc-01.webp\" alt=\"INKO Melbourne studio, photo 1\" loading=\"lazy\" decoding=\"async\">\n      <img src=\"/wp-content/themes/inko-melbourne/assets/images/loc-02.webp\" alt=\"INKO Melbourne studio, photo 2\" loading=\"lazy\" decoding=\"async\">\n      <img src=\"/wp-content/themes/inko-melbourne/assets/images/loc-03.webp\" alt=\"INKO Melbourne studio, photo 3\" loading=\"lazy\" decoding=\"async\">\n      <img src=\"/wp-content/themes/inko-melbourne/assets/images/loc-04.webp\" alt=\"INKO Melbourne studio, photo 4\" loading=\"lazy\" decoding=\"async\">\n      <img src=\"/wp-content/themes/inko-melbourne/assets/images/loc-05.webp\" alt=\"INKO Melbourne studio, photo 5\" loading=\"lazy\" decoding=\"async\">\n      <img src=\"/wp-content/themes/inko-melbourne/assets/images/loc-06.webp\" alt=\"INKO Melbourne studio, photo 6\" loading=\"lazy\" decoding=\"async\">\n      <img src=\"/wp-content/themes/inko-melbourne/assets/images/loc-07.webp\" alt=\"INKO Melbourne studio, photo 7\" loading=\"lazy\" decoding=\"async\">\n      <img src=\"/wp-content/themes/inko-melbourne/assets/images/loc-08.webp\" alt=\"INKO Melbourne studio, photo 8\" loading=\"lazy\" decoding=\"async\">\n      <img src=\"/wp-content/themes/inko-melbourne/assets/images/loc-09.webp\" alt=\"INKO Melbourne studio, photo 9\" loading=\"lazy\" decoding=\"async\">\n    </div>\n  </section>\n\n  <section class=\"ih-reviews\" id=\"reviews\" aria-labelledby=\"ih-reviews-title\">\n    <div class=\"ih-google-mark\"><img class=\"ih-google-g\" src=\"/wp-content/themes/inko-melbourne/assets/icons/google-g.svg\" alt=\"\"><span>Google</span></div>\n    <p class=\"ih-eyebrow\">From our community</p><h2 id=\"ih-reviews-title\">Google <em>reviews.</em></h2>\n    <p>Read the latest reviews on Google.</p>\n    <a class=\"ih-button ih-button--outline\" href=\"https://www.google.com/maps/search/?api=1&query=INKO+Melbourne%2C+1C+Cookson+Street%2C+Camberwell+VIC+3142\" target=\"_blank\" rel=\"noopener\">Read Google reviews <span aria-hidden=\"true\">↗</span></a>\n  </section>\n\n  <section class=\"ih-quote\" id=\"quote\" aria-labelledby=\"ih-quote-title\">\n    <div class=\"ih-quote__intro\"><p class=\"ih-eyebrow\">Start your tattoo journey</p><h2 id=\"ih-quote-title\">GET A <em>QUOTATION</em></h2><p>Have a tattoo idea in mind? Send us your design and we’ll get back to you with a personalised quote.</p><img src=\"/wp-content/themes/inko-melbourne/assets/images/quote-machine.webp\" alt=\"INKO Melbourne tattoo machine\" loading=\"lazy\" decoding=\"async\"></div>\n    <div class=\"ih-quote__form-slot\"><form class=\"q-form\" id=\"quote-form\" action=\"/api/quote\" method=\"post\" enctype=\"multipart/form-data\" novalidate>\n\t\t\t<p class=\"q-req-note\"><span aria-hidden=\"true\">*</span> Required field</p>\n\n\t\t\t<fieldset class=\"q-field q-name\">\n\t\t\t\t<legend>Name <span class=\"q-req\" aria-hidden=\"true\">*</span></legend>\n\t\t\t\t<div class=\"q-row\">\n\t\t\t\t\t<div class=\"q-sub\">\n\t\t\t\t\t\t<label for=\"q-first\">First Name <span class=\"q-req\" aria-hidden=\"true\">*</span></label>\n\t\t\t\t\t\t<input id=\"q-first\" name=\"firstName\" type=\"text\" autocomplete=\"given-name\" maxlength=\"80\" required aria-describedby=\"q-first-err\">\n\t\t\t\t\t\t<p class=\"q-err\" id=\"q-first-err\"></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"q-sub\">\n\t\t\t\t\t\t<label for=\"q-last\">Last Name <span class=\"q-req\" aria-hidden=\"true\">*</span></label>\n\t\t\t\t\t\t<input id=\"q-last\" name=\"lastName\" type=\"text\" autocomplete=\"family-name\" maxlength=\"80\" required aria-describedby=\"q-last-err\">\n\t\t\t\t\t\t<p class=\"q-err\" id=\"q-last-err\"></p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</fieldset>\n\n\t\t\t<div class=\"q-field\">\n\t\t\t\t<label for=\"q-email\">Email <span class=\"q-req\" aria-hidden=\"true\">*</span></label>\n\t\t\t\t<input id=\"q-email\" name=\"email\" type=\"email\" autocomplete=\"email\" inputmode=\"email\" maxlength=\"254\" required aria-describedby=\"q-email-err\">\n\t\t\t\t<p class=\"q-err\" id=\"q-email-err\"></p>\n\t\t\t</div>\n\n\t\t\t<div class=\"q-field\">\n\t\t\t\t<label for=\"q-phone\">Phone</label>\n\t\t\t\t<input id=\"q-phone\" name=\"phone\" type=\"tel\" autocomplete=\"tel\" inputmode=\"tel\" maxlength=\"25\" aria-describedby=\"q-phone-err\">\n\t\t\t\t<p class=\"q-err\" id=\"q-phone-err\"></p>\n\t\t\t</div>\n\n\t\t\t<div class=\"q-field\">\n\t\t\t\t<label for=\"q-file\">File Upload</label>\n\t\t\t\t<p class=\"q-hint\" id=\"q-file-hint\">Attach your tattoo reference or design: JPG, PNG, WEBP, HEIC or PDF, up to 4 MB.</p>\n\t\t\t\t<div class=\"q-file\">\n\t\t\t\t\t<input id=\"q-file\" name=\"file\" type=\"file\" accept=\".jpg,.jpeg,.png,.webp,.heic,.heif,.pdf,image/jpeg,image/png,image/webp,image/heic,image/heif,application/pdf\" aria-describedby=\"q-file-hint q-file-err\">\n\t\t\t\t\t<label for=\"q-file\" class=\"q-file__btn\">Choose file</label>\n\t\t\t\t\t<span class=\"q-file__name\" id=\"q-file-name\">No file chosen</span>\n\t\t\t\t\t<button type=\"button\" class=\"q-file__clear\" id=\"q-file-clear\" hidden>Remove</button>\n\t\t\t\t</div>\n\t\t\t\t<p class=\"q-err\" id=\"q-file-err\"></p>\n\t\t\t</div>\n\n\t\t\t<div class=\"q-field\">\n\t\t\t\t<label for=\"q-details\">Details <span class=\"q-req\" aria-hidden=\"true\">*</span></label>\n\t\t\t\t<p class=\"q-hint\" id=\"q-details-hint\">Tell us the <strong>size</strong>, <strong>placement</strong> and <strong>color preference</strong> for your tattoo.</p>\n\t\t\t\t<textarea id=\"q-details\" name=\"details\" rows=\"7\" maxlength=\"5000\" required aria-describedby=\"q-details-hint q-details-err\" placeholder=\"Size: e.g. 10 cm x 6 cm&#10;Placement: e.g. left forearm&#10;Color preference: e.g. black &amp; grey\"></textarea>\n\t\t\t\t<p class=\"q-err\" id=\"q-details-err\"></p>\n\t\t\t</div>\n\n\t\t\t<div class=\"q-hp\" aria-hidden=\"true\">\n\t\t\t\t<label for=\"q-website\">Leave this field empty</label>\n\t\t\t\t<input id=\"q-website\" name=\"website\" type=\"text\" tabindex=\"-1\" autocomplete=\"off\">\n\t\t\t</div>\n\n\t\t\t<div class=\"q-status\" id=\"q-status\" role=\"alert\" hidden></div>\n\n\t\t\t<button class=\"q-send\" type=\"submit\">\n\t\t\t\t<span class=\"q-send__txt\">Send</span>\n\t\t\t\t<svg aria-hidden=\"true\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3z\"></path></svg>\n\t\t\t</button>\n\t\t</form></div>\n  </section>\n\n  <footer class=\"ih-footer\" id=\"contact\">\n    <a class=\"ih-footer__logo\" href=\"#home\" aria-label=\"INKO Melbourne home\"><img src=\"/wp-content/themes/inko-melbourne/assets/icons/logo-box.png\" alt=\"INKO Melbourne\" width=\"464\" height=\"332\" loading=\"lazy\"></a>\n    <p>1c Cookson Street, Camberwell, VIC 3142</p>\n    <div class=\"ih-footer__links\"><a href=\"mailto:inko.melbourne@gmail.com\">Email</a><a href=\"tel:+61481082077\">Call</a><a href=\"https://www.instagram.com/inko_melbourne/\" target=\"_blank\" rel=\"noopener\">Instagram</a><a href=\"https://www.facebook.com/inkomelbourne/\" target=\"_blank\" rel=\"noopener\">Facebook</a><a href=\"https://www.threads.com/@inko_melbourne\" target=\"_blank\" rel=\"noopener\">Threads</a></div>\n    <small>© INKO Melbourne</small>\n  </footer>\n</div>\n"
          },
          "elements": []
        }
      ]
    }
  ],
  "elements": []
}
